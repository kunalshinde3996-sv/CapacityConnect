# Copy to apps/web/.env.local for local development (optional: the default below is used if unset).

# Where the Express API runs. The web app proxies every /api/* request to it
# (see next.config.ts), so the browser only ever talks to this site.
# Server-side and read at BUILD time: not exposed to the browser.
#   Local:       http://localhost:4000
#   Production:  your Render API URL, e.g. https://capacity-connect-api.onrender.com
API_ORIGIN=http://localhost:4000

# Public origin of the API, used for file uploads and downloads (they skip the /api proxy).
# Local: http://localhost:4000   Production: your Render API URL.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
