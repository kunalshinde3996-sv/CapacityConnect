# Copy to apps/web/.env.local for local development (optional: the default below is used if unset).
# Both values are read at BUILD time: after changing them in Vercel, redeploy.

# Public address of the Express API. The only setting production needs. It is used for:
#   - the /api/* proxy (see next.config.ts), so the browser only ever talks to this site
#   - file uploads and downloads, which go straight to the API (no proxy size limits)
# Public, not a secret: it ends up in the browser bundle.
#   Local:       http://localhost:4000
#   Production:  your Render API URL, e.g. https://capacity-connect-api-833b.onrender.com
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Optional: a different address for the /api/* proxy only (server-side). Leave unset to
# use NEXT_PUBLIC_API_ORIGIN for both.
# API_ORIGIN=
