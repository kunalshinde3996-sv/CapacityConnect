# Copy to apps/api/.env for local development:  cp .env.example .env
# Never commit the real .env file.
#
# Each variable notes its PRODUCTION value (set in the Render dashboard, never in a file).

# Production: production (set by render.yaml)
NODE_ENV=development

# Production: leave unset, Render provides PORT
PORT=4000

# Local Postgres from docker-compose (host port 5433).
# Production: the Neon connection string, using the DIRECT host (not the one containing
# "-pooler"), ending in ?sslmode=require. Example shape:
#   postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://capacity:capacity@localhost:5433/capacity_connect?schema=public

# Origins allowed to call the API directly (comma-separated). The browser normally goes
# through the web app's /api proxy, so this is a second line of defence.
# Production: your Vercel URL, e.g. https://capacity-connect.vercel.app
CORS_ORIGINS=http://localhost:3000

# Long random string used to sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production: generated by Render (render.yaml: generateValue). Must differ from local.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional. bcrypt work factor (default 10). Only lower it for tests.
# BCRYPT_COST=10

# ── Only for seeding a HOSTED database (never set these on Render) ──────────────
# The seed refuses any non-local database unless both are set. The password replaces
# the public demo password for every demo account on the live site; keep it private.
# SEED_ALLOW_PROD=true
# SEED_DEMO_PASSWORD=a-private-password-of-12-or-more-characters

# Uploaded files (local-disk storage) and upload size limit.
# Production (Render free): files are lost on restart; see README "Deployment".
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=50

# Email. Without SMTP_HOST, emails are only written to the console (the current setup,
# also in production). To send real email later, set these on Render:
# SMTP_HOST=smtp-relay.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Capacity Connect <no-reply@your-domain>

# Proxies in front of the API (for real client IPs in rate limiting). Local: 0.
# Production (Render behind the Vercel proxy): 2
# TRUST_PROXY_HOPS=0
