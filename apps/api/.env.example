# Copy to apps/api/.env for local development:  cp .env.example .env
# Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Local Postgres from docker-compose (host port 5433)
DATABASE_URL=postgresql://capacity:capacity@localhost:5433/capacity_connect?schema=public

# Browser origins allowed to call the API (comma-separated). In production: your Vercel URL.
CORS_ORIGINS=http://localhost:3000

# Long random string used to sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional. bcrypt work factor (default 10). Only lower it for tests.
# BCRYPT_COST=10
